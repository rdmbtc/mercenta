# Copy to server-side deployment secrets. Read onramp.md before enabling.
# No NEXT_PUBLIC_ variables. Keep actual keys out of source control.
# recorded is the default: settlement-backed accounting remains gated.
# Set direct_wallet explicitly only for non-custodial launch without deposit records.
ONRAMP_MODE=recorded
ONRAMP_ENABLED=false
ONRAMP_ENVIRONMENT=sandbox
ONRAMP_API_KEY=
ONRAMP_APP_ORIGIN=http://localhost:3000
ONRAMP_DATABASE_URL=
ONRAMP_WEBHOOK_ENCRYPTION_KEY=
ONRAMP_WEBHOOK_PROFILE=
ONRAMP_WEBHOOK_CONTRACT_VERIFIED=false
ONRAMP_RECONCILIATION_VERIFIED=false
