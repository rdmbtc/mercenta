NODE_ENV=development
HOST=127.0.0.1
PORT=3012
DATABASE_PATH=data/mercenta.sqlite
# Generate independent 32+ character secrets. Never commit .env.
BACKEND_PROXY_SECRET=
SESSION_SECRET=
REQUEST_REF_SECRET=
# 32 bytes in hexadecimal (64 characters).
DELIVERY_ENCRYPTION_KEY=
ARC_RPC_URL=https://rpc.testnet.arc.network
MERCHANT_WALLET=
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
ENABLE_FULFILLMENT=false
# Validated, server-only merchant sale/cost quotes; no client-supplied prices.
CATALOG_QUOTES_PATH=
CIRCLE_API_KEY=
ONRAMP_API_KEY=
WEB_ORIGIN=http://localhost:3011
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Supervised VPS resource guard; optional caches never decide funds.
MEMORY_SOFT_LIMIT_MB=768
MAX_INFLIGHT_REQUESTS=32
# Set these only in private environment files. An explicit future deadline is mandatory.
TEMP_REDIS_URL=
TEMP_POSTGRES_URL=
TEMP_POSTGRES_CA_PATH=
TEMP_POSTGRES_CA_BASE64=
TEMP_SERVICES_EXPIRES_AT=

# Independent HTTPS Testnet RPC for receipt verification. Empty means verification stays blocked.
# ARC_SECONDARY_RPC_URL=

# Server-only exact HTTPS origin pin. Must match SUPPLIER_API_URL; missing/mismatched values fail closed.
# SUPPLIER_ALLOWED_ORIGIN=
