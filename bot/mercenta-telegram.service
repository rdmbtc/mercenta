[Unit]
Description=Mercenta Telegram long-polling bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=mercenta-telegram
StateDirectoryMode=0700
WorkingDirectory=/opt/mercenta-telegram
LoadCredentialEncrypted=bot-token:/etc/credstore.encrypted/mercenta-telegram-token
ExecStart=/usr/bin/python3 -u /opt/mercenta-telegram/bot.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
